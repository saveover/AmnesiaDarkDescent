<Page
    x:Class="SaveOver.AmnesiaDarkDescent.Pages.CharacterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SaveOver.AmnesiaDarkDescent.Converters">

    <Page.Resources>
        <converters:FiniteNumberConverter x:Key="FiniteNumberConverter"/>
        <converters:Int32NumberConverter x:Key="Int32NumberConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="36,24,36,0"
                   MaxWidth="{StaticResource PageContentMaxWidth}"
                   Text="Character"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <ScrollView Grid.Row="1">
            <StackPanel Margin="36,16,36,40"
                        MaxWidth="{StaticResource PageContentMaxWidth}"
                        Spacing="20">
                <TextBlock Text="Health, sanity, and lamp oil use the game's 0–100 range. Tinderboxes use the save format's non-negative 32-bit integer range."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>

                <Grid x:Name="EditorGrid" ColumnSpacing="20" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="NarrowEditor">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0"/>
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="ResourcesCard.(Grid.Row)" Value="1"/>
                                    <Setter Target="ResourcesCard.(Grid.Column)" Value="0"/>
                                    <Setter Target="ResourcesCard.(Grid.ColumnSpan)" Value="2"/>
                                    <Setter Target="ConditionCard.(Grid.ColumnSpan)" Value="2"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideEditor">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="900"/>
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="ConditionCard.(Grid.ColumnSpan)" Value="1"/>
                                    <Setter Target="ResourcesCard.(Grid.Row)" Value="0"/>
                                    <Setter Target="ResourcesCard.(Grid.Column)" Value="1"/>
                                    <Setter Target="ResourcesCard.(Grid.ColumnSpan)" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border x:Name="ConditionCard" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Condition"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="Player health and sanity."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="Min"
                                            Click="ConditionMinimumButton_Click"
                                            AutomationProperties.Name="Set health and sanity to minimum"
                                            ToolTipService.ToolTip="Set health and sanity to 0"/>
                                    <Button Content="Max"
                                            Click="ConditionMaximumButton_Click"
                                            AutomationProperties.Name="Set health and sanity to maximum"
                                            ToolTipService.ToolTip="Set health and sanity to 100"/>
                                </StackPanel>
                            </Grid>

                            <NumberBox Header="&#x2764; Health"
                                       SpinButtonPlacementMode="Inline"
                                       Minimum="0"
                                       Maximum="100"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind Player.Health, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}"/>
                            <NumberBox Header="&#x1F9E0; Sanity"
                                       SpinButtonPlacementMode="Inline"
                                       Minimum="0"
                                       Maximum="100"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind Player.Sanity, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResourcesCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Resources"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="Lantern fuel and tinderboxes."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="Min"
                                            Click="ResourcesMinimumButton_Click"
                                            AutomationProperties.Name="Set lamp oil and tinderboxes to minimum"
                                            ToolTipService.ToolTip="Set lamp oil and tinderboxes to 0"/>
                                    <Button Content="Max"
                                            Click="ResourcesMaximumButton_Click"
                                            AutomationProperties.Name="Set lamp oil and tinderboxes to maximum"
                                            ToolTipService.ToolTip="Set lamp oil to 100 and tinderboxes to 2,147,483,647"/>
                                </StackPanel>
                            </Grid>

                            <NumberBox Header="&#x1F6E2; Lamp oil"
                                       SpinButtonPlacementMode="Inline"
                                       Minimum="0"
                                       Maximum="100"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind Player.LampOil, Mode=TwoWay, Converter={StaticResource FiniteNumberConverter}}"/>
                            <NumberBox Header="&#x1F56F; Tinderboxes"
                                       SpinButtonPlacementMode="Inline"
                                       Minimum="0"
                                       Maximum="2147483647"
                                       ValidationMode="InvalidInputOverwritten"
                                       Value="{x:Bind Player.Tinderboxes, Mode=TwoWay, Converter={StaticResource Int32NumberConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Saving"
                         Message="Return to Home to write your changes."/>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
