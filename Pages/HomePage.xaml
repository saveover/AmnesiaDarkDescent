<Page
    x:Class="SaveOver.AmnesiaDarkDescent.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="36,24,36,0"
                   MaxWidth="{StaticResource PageContentMaxWidth}"
                   Text="Home"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <ScrollView Grid.Row="1">
            <StackPanel Margin="36,16,36,40"
                        MaxWidth="{StaticResource PageContentMaxWidth}"
                        Spacing="24">
                <TextBlock Text="Open, edit, and safely back up Amnesia: The Dark Descent saves."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid x:Name="WorkspaceGrid" ColumnSpacing="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="WorkspaceVisualColumn" Width="260"/>
                        </Grid.ColumnDefinitions>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="CompactWorkspace">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="WorkspaceVisualPanel.Visibility" Value="Collapsed"/>
                                        <Setter Target="WorkspaceVisualColumn.Width" Value="0"/>
                                        <Setter Target="SaveFileButton.HorizontalAlignment" Value="Stretch"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WideWorkspace">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="800"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="WorkspaceVisualPanel.Visibility" Value="Visible"/>
                                        <Setter Target="WorkspaceVisualColumn.Width" Value="260"/>
                                        <Setter Target="SaveFileButton.HorizontalAlignment" Value="Left"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Spacing="20">
                            <TextBlock x:Name="WorkspaceTitleTextBlock"
                                       Text="Choose a save file"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       AutomationProperties.HeadingLevel="Level2"/>

                            <Button x:Name="LoadFileButton"
                                    Padding="16,14"
                                    AllowDrop="True"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="LoadFileButton_Click"
                                    DragOver="SaveDropZone_DragOver"
                                    Drop="SaveDropZone_Drop"
                                    AutomationProperties.Name="Open or drop an Amnesia SAV save file">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Upload"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                AutomationProperties.AccessibilityView="Raw"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Open or drop a save file"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="Click to browse, or drag one Amnesia .sav file here."
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="SaveFileButton"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False"
                                    Click="SaveFileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="16"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="Save changes"/>
                                </StackPanel>
                            </Button>

                            <Border Padding="12,10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE946;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock x:Name="LoadFileTextBlock"
                                               Grid.Column="1"
                                               Text="No save file is currently open."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border x:Name="WorkspaceVisualPanel"
                            Grid.Column="1"
                            Padding="24"
                            MinHeight="240"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="12">
                            <StackPanel Spacing="18">
                                <Border Width="48"
                                    Height="48"
                                    CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE72E;"
                                          FontSize="22"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                                </Border>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Safe by default"
                                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="SaveOver protects the original before applying your edits."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE73E;"
                                              FontSize="13"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Text="Validates before opening"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE73E;"
                                              FontSize="13"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Text="Creates a timestamped backup"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE73E;"
                                              FontSize="13"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                        <TextBlock Text="Replaces the file atomically"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <InfoBar x:Name="OperationInfoBar"
                         IsOpen="False"
                         IsClosable="True"/>

                <Border Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Looking for your saves?"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="%USERPROFILE%\Documents\Amnesia\Main"
                                       Style="{StaticResource MonospaceTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <Button Content="Open folder"
                                    Click="OpenSaveFolderButton_Click"
                                    AutomationProperties.Name="Open Amnesia save folder"/>
                            <Button x:Name="CopyPathButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CopyPathButton_Click"
                                    AutomationProperties.Name="Copy save folder path"
                                    ToolTipService.ToolTip="Copy path to clipboard">
                                <Grid>
                                    <FontIcon Glyph="&#xE8C8;"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <FontIcon Glyph="&#xE73E;"
                                              FontSize="14"
                                              Opacity="0"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="What you can edit"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <Grid ColumnSpacing="18" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Condition" FontWeight="SemiBold"/>
                                <TextBlock Text="Health and sanity"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Resources" FontWeight="SemiBold"/>
                                <TextBlock Text="Lamp oil and tinderboxes"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="True"
                         Severity="Warning"
                         IsClosable="False"
                         Title="Edit carefully"
                         Message="SaveOver creates backups, but game saves can still be sensitive to unexpected values. Review your changes before saving.">
                    <InfoBar.ActionButton>
                        <HyperlinkButton Content="View licence"
                                         NavigateUri="https://github.com/saveover/AmnesiaDarkDescent/blob/master/LICENSE.txt"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="CompactSupport">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="SupportActionPanel.(Grid.Row)" Value="1"/>
                                        <Setter Target="SupportActionPanel.(Grid.Column)" Value="0"/>
                                        <Setter Target="SupportActionPanel.Margin" Value="0,16,0,0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WideSupport">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="800"/>
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="SupportActionPanel.(Grid.Row)" Value="0"/>
                                        <Setter Target="SupportActionPanel.(Grid.Column)" Value="1"/>
                                        <Setter Target="SupportActionPanel.Margin" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Built in the open"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="SaveOver is free and open source. Contributions, useful bug reports, and donations all help it improve."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="SupportActionPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <HyperlinkButton NavigateUri="https://github.com/saveover/AmnesiaDarkDescent">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8A7;"
                                              FontSize="15"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="GitHub"/>
                                </StackPanel>
                            </HyperlinkButton>
                            <Button Click="SupportButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xEB51;"
                                              FontSize="15"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Text="Support"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
